# Desenvolvimento local
NODE_ENV=development
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=producao_consciente
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
MYSQL_AUTO_CREATE_DATABASE=true
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Produção: NODE_ENV=production e APP_ORIGIN=https://seu-dominio.com (sem barra final).
# MYSQL_AUTO_CREATE_DATABASE=false e usuário restrito ao banco da aplicação.
# Execute npm run db:init antes do deploy, com credencial de migração.
# Em produção, o processo normal não cria/alterar tabelas por padrão.
# Não configurar MYSQL_MIGRATE_ON_START=true no serviço público.
# APP_ORIGIN=

# Se houver proxy reverso, informe SOMENTE os IPs/CIDRs documentados pelo provedor.
# Sem esta opção, o limite considera o IP direto da conexão; não confia em X-Forwarded-For.
# TRUST_PROXY=

# JWT opcional para clientes que solicitam authMode=bearer no login.
# Gere uma chave aleatória de pelo menos 32 bytes e configure somente no ambiente.
# JWT_SECRET=
# CORS_ORIGIN pode substituir APP_ORIGIN se contiver uma origem HTTPS exata.
# CORS_ORIGIN=
