# Servidor HTTP
PORT=3000

# MySQL / DBeaver
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=producao_consciente
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10

# Segurança JWT — troque por uma chave longa e aleatória
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# CORS (deixe true para desenvolvimento local)
CORS_ORIGIN=true

# Vercel / MySQL gerenciado
# Na Vercel, deixe false porque o banco já deve existir no provedor.
MYSQL_AUTO_CREATE_DATABASE=true
# Use true se o seu provedor exigir TLS/SSL.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
