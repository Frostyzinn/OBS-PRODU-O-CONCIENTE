{
  "name": "producao-consciente",
  "version": "3.3.0",
  "description": "SaaS profissional multiempresa para gestão da produção de materiais de construção, com interface viva, paleta azul blueprint + prata e deploy serverless na Vercel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "db:init": "node -e \"require('./db/database').initDatabase().then(()=>require('./db/database').close())\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  }
}
